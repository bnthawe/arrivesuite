NODE_ENV=development
APP_NAME=ArriveSuite
APP_URL=http://localhost:3000
BOOKING_REF_PREFIX=ARS

DATABASE_URL=postgresql://arrivesuite:arrivesuite_dev_password@localhost:5432/arrivesuite

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arrivesuite-media
S3_ACCESS_KEY_ID=arrivesuite_minio
S3_SECRET_ACCESS_KEY=arrivesuite_minio_password
S3_FORCE_PATH_STYLE=true

BETTER_AUTH_SECRET=change_me_dev_only_32_chars_minimum_xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@arrivesuite.local

PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=ARE
PAYTABS_WEBHOOK_SECRET=

DUFFEL_API_KEY=duffel_test_xxx
DUFFEL_ENV=test

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

SENTRY_DSN=
AXIOM_TOKEN=

ENABLE_FLIGHTS=true
ENABLE_HOTELS=true
ENABLE_TOURS=false
ENABLE_WHATSAPP=true
ENABLE_SOURCED_INVENTORY=true
