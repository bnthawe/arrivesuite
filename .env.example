NODE_ENV=development
APP_NAME=ArriveSuite
APP_URL=http://localhost:3000
BOOKING_REF_PREFIX=ARS

DATABASE_URL=postgresql://arrivesuite:arrivesuite_dev_password@localhost:5432/arrivesuite
# postgres.js reads ?sslmode= from the URL: none locally, ?sslmode=require
# minimum on Neon, ?sslmode=verify-full preferred in production.

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arrivesuite-media
S3_ACCESS_KEY_ID=arrivesuite_minio
S3_SECRET_ACCESS_KEY=change_me_minio_password
S3_FORCE_PATH_STYLE=true
# VOUCHER_STORAGE=local keeps PDFs under public/cdn/tickets.
# Set to r2 (with the S3_* vars pointed at R2) to upload instead.
VOUCHER_STORAGE=local
# VOUCHER_DIR overrides the local ticket dir when the processcwd is not
# apps/web (e.g. pnpm --filter from the repo root).

BETTER_AUTH_SECRET=change_me_dev_only_32_chars_minimum_xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
PRICING_SIGNING_SECRET=change_me_dev_only_32_chars_minimum_xxxxxxxx

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@arrivesuite.local

# Contract v1.0 providers: LiteAPI (hotels), OnArrival (flights),
# Paystack primary + Flutterwave/Stripe fallback. Duffel/Amadeus/PayTabs
# below are superseded but kept for the Phase 1 cutover window.
LITEAPI_SANDBOX_KEY=sand_xxx
LITEAPI_LIVE_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_BOOK_URL=https://book.liteapi.travel/v3.0

ONARRIVAL_API_KEY=onarr_xxx
ONARRIVAL_BASE_URL=https://dev.gateway.onarrival.com/v1
ONARRIVAL_TICKETING_AUTHORITY=ONARRIVAL
ONARRIVAL_WEBHOOK_SECRET=
ONARRIVAL_DISRUPTION_WEBHOOK_URL=https://arrivesuite.app/api/webhooks/onarrival/disruption

PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_MODE=sandbox
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_MODE=sandbox
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MODE=sandbox
NEXT_PUBLIC_PAYSTACK_KEY=pk_test_xxx

# DPO Pay (mobile money + cards). Copy sandbox credentials from
# https://docs.dpopay.com/dpo-pay-by-network/reference/sandbox-test-credentials
# into .env.local. Never commit the company token, service ids, or test cards.
DPO_PAY_COMPANY_TOKEN=
DPO_PAY_PRODUCT_SERVICE_ID=
DPO_PAY_SERVICE_SERVICE_ID=
DPO_PAY_BASE_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAY_MODE=sandbox

ARS_REF_PREFIX=ARS
ARS_CHAR_LENGTH=16
ARS_FLOAT_PCT=0.005
ARS_NO_FX_BUFFER=true
ARS_LEDGER_MODE=D11

VOUCHER_CDN_BASE=/cdn/tickets
WHATSAPP_TEMPLATE=ars_booking_confirmed
TRACE_ID_HEADER=x-trace-id

PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=ARE
PAYTABS_WEBHOOK_SECRET=

DUFFEL_API_KEY=duffel_test_xxx
DUFFEL_ENV=test

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

SENTRY_DSN=
AXIOM_TOKEN=

ENABLE_FLIGHTS=true
ENABLE_HOTELS=true
ENABLE_TOURS=false
ENABLE_WHATSAPP=true
ENABLE_SOURCED_INVENTORY=true
